<?xml version="1.0" encoding="UTF-8"?>
<api context="/mi/jdbc/v1" name="SIISJdbcApi" xmlns="http://ws.apache.org/ns/synapse">
    <resource methods="POST" uri-template="/{apiName}/dbservice">
        <inSequence>
            <property expression="get-property('SYSTEM_TIME')" name="startTime" scope="default" type="STRING"/>
            <property name="eventType" scope="default" type="STRING" value="JDBCService"/>
            <!-- 
            <filter regex="true" source="boolean($ctx:msgID)=false or $ctx:msgID=''">
                <then>
                    <property expression="get-property('MessageID')" name="msgID" scope="default" type="STRING"/>
                </then>
                <else/>
            </filter>
             -->
            <property expression="$ctx:uri.var.apiName" name="apiName" scope="default" type="STRING"/>
            <log level="custom">
                <property expression="$ctx:msgID" name="msgID"/>
                <property expression="$ctx:apiName" name="Started SiiS Rest/Jdbc Service : "/>
            </log>
            <filter xpath="string-length(get-property('apiName')) = 0">
                <then>
                    <log level="custom">
                        <property name="ERROR" value="apiName property is not set"/>
                    </log>
                    <payloadFactory media-type="json">
                        <format>{                        
		                    "success": false,
		                    "code": "E001",
		                    "message": "API Name is required",
		                    "errorDetail": "apiName property must be set before calling JdbcCommonSequence"
		                }</format>
                        <args/>
                    </payloadFactory>
                    <property name="HTTP_SC" scope="axis2" type="STRING" value="400"/>
                    <property name="messageType" scope="axis2" type="STRING" value="application/json"/>
                    <property name="ContentType" scope="axis2" type="STRING" value="application/json"/>
                    <property expression="json-eval($.)" name="eventDetail" scope="default" type="STRING"/>
                    <respond/>
                </then>
                <else/>
            </filter>
            <sequence description="Call Sequence" key="JdbcCommonSequence"/>
            <filter regex="true" source="boolean($ctx:BIZ_ERROR_MESSAGE) and $ctx:BIZ_ERROR_MESSAGE!=''">
                <then>
                    <property expression="$ctx:BIZ_ERROR_MESSAGE" name="ERROR_MESSAGE" scope="default" type="STRING"/>
                    <sequence key="JdbcFault"/>
                </then>
                <else>
                    <property expression="get-property('SYSTEM_TIME')" name="endTime" scope="default" type="STRING"/>
                    <property expression="fn:string($ctx:endTime - $ctx:startTime)" name="elapsedTime" scope="default" type="STRING"/>
                    <log level="custom">
                        <property expression="$ctx:msgID" name="msgID"/>
                        <property expression="fn:concat($ctx:elapsedTime,'ms')" name="API Total Elapsed Time"/>
                    </log>
                    <property name="HTTP_SC" scope="axis2" type="STRING" value="200"/>
                    <property name="messageType" scope="axis2" type="STRING" value="application/json"/>
                    <property name="Content-Type" scope="transport" type="STRING" value="application/json"/>
                    <respond/>
                </else>
            </filter>
        </inSequence>
        <outSequence/>
        <faultSequence/>
    </resource>
</api>
